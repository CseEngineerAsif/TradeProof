rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null
        && firestore.exists(
          /databases/(default)/documents/admins/$(request.auth.uid)
        );
    }

    function isActiveAccount(uid) {
      let userPath = /databases/(default)/documents/users/$(uid);
      return request.auth != null
        && (isAdmin()
          || (firestore.exists(userPath)
            && (!firestore.get(userPath).data.keys().hasAny(['status'])
              || firestore.get(userPath).data.status == 'active')));
    }

    match /account_applications/{uid}/{fileName} {
      allow read: if request.auth != null
        && (request.auth.uid == uid || isAdmin());
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType in [
          'application/pdf',
          'application/msword',
          'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
        ];
      allow delete: if isAdmin();
    }

    match /portfolio/{uid}/{file} {
      allow read: if request.auth != null
        && isActiveAccount(request.auth.uid);
      allow write: if request.auth != null
        && isActiveAccount(uid)
        && request.auth.uid == uid
                   && request.resource.size < 5 * 1024 * 1024;
    }
  }
}
