rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isConnectionParticipant(requestId) {
      let connection = get(
        /databases/$(database)/documents/connection_requests/$(requestId)
      ).data;
      return signedIn()
        && (connection.ownerUid == request.auth.uid
          || connection.requesterUid == request.auth.uid);
    }

    function connectionAccepted(requestId) {
      return get(
        /databases/$(database)/documents/connection_requests/$(requestId)
      ).data.status == 'accepted';
    }

    function validCoursePayment(postId) {
      let data = request.resource.data;
      let paymentKeys = ['paymentMethod', 'paymentStatus', 'amountBdt'];
      let hasPayment = data.keys().hasAny(paymentKeys);
      let post = get(
        /databases/$(database)/documents/marketplace_posts/$(postId)
      ).data;
      return !hasPayment
        || (data.keys().hasAll(paymentKeys)
          && data.type == 'course'
          && data.paymentMethod in [
            'bkash_demo', 'nagad_demo', 'cash', 'bank_transfer'
          ]
          && data.amountBdt is int
          && data.amountBdt > 0
          && data.amountBdt == post.priceBdt
          && ((data.paymentMethod in ['bkash_demo', 'nagad_demo']
              && data.paymentStatus == 'simulated')
            || (data.paymentMethod == 'cash'
              && data.paymentStatus == 'awaiting_cash')
            || (data.paymentMethod == 'bank_transfer'
              && data.paymentStatus == 'awaiting_bank_transfer')));
    }

    match /users/{userId} {
      allow read, create, update: if signedIn()
        && request.auth.uid == userId;
      allow delete: if false;
    }

    match /marketplace_posts/{postId} {
      allow read: if signedIn()
        && (resource.data.status == 'published'
          || resource.data.ownerUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'ownerName', 'ownerRole', 'type', 'title', 'category',
          'description', 'status', 'createdAt', 'priceBdt'
        ])
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerName is string
        && request.resource.data.ownerRole is string
        && request.resource.data.status == 'published'
        && request.resource.data.type in ['service', 'course', 'job']
        && request.resource.data.title is string
        && request.resource.data.category is string
        && request.resource.data.description is string
        && (request.resource.data.type != 'course'
          || (request.resource.data.priceBdt is int
            && request.resource.data.priceBdt > 0));
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.status in ['published', 'closed'];
      allow delete: if false;
    }

    match /connection_requests/{requestId} {
      allow get: if signedIn()
        && ((!exists(
          /databases/$(database)/documents/connection_requests/$(requestId)
        )
          && requestId.startsWith(request.auth.uid + '-'))
          || resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid);
      allow list: if signedIn()
        && (resource.data.ownerUid == request.auth.uid
          || resource.data.requesterUid == request.auth.uid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly([
          'postId', 'type', 'title', 'ownerUid', 'ownerName', 'requesterUid',
          'requesterName', 'status', 'createdAt', 'paymentMethod',
          'paymentStatus', 'amountBdt'
        ])
        && request.resource.data.requesterUid == request.auth.uid
        && request.resource.data.requesterName is string
        && request.resource.data.ownerUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.postId is string
        && exists(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        )
        && get(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        ).data.ownerUid == request.resource.data.ownerUid
        && get(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        ).data.status == 'published'
        && get(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        ).data.type == request.resource.data.type
        && get(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        ).data.title == request.resource.data.title
        && get(
          /databases/$(database)/documents/marketplace_posts/$(request.resource.data.postId)
        ).data.ownerName == request.resource.data.ownerName
        && validCoursePayment(request.resource.data.postId);
      allow update: if signedIn()
        && resource.data.ownerUid == request.auth.uid
        && ((resource.data.status == 'pending'
            && request.resource.data.status in ['accepted', 'rejected']
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['status', 'updatedAt']))
          || (resource.data.status == 'accepted'
            && resource.data.type == 'course'
            && resource.data.paymentMethod in ['cash', 'bank_transfer']
            && resource.data.paymentStatus in [
              'awaiting_cash', 'awaiting_bank_transfer'
            ]
            && request.resource.data.paymentStatus == 'confirmed_offline'
            && request.resource.data.paymentConfirmedAt == request.time
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['paymentStatus', 'paymentConfirmedAt'])));
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isConnectionParticipant(requestId)
          && connectionAccepted(requestId);
        allow create: if isConnectionParticipant(requestId)
          && connectionAccepted(requestId)
          && request.resource.data.keys().hasOnly([
            'senderUid', 'senderName', 'text', 'createdAt'
          ])
          && request.resource.data.senderUid == request.auth.uid
          && request.resource.data.senderName is string
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 5000;
        allow update, delete: if false;
      }
    }
  }
}
